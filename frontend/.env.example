# API Gateway URL (Nginx)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost

# Domain Service URLs
NEXT_PUBLIC_SITE_SERVICE_URL=http://localhost:8010
NEXT_PUBLIC_STOREFRONT_SERVICE_URL=http://localhost:8011
NEXT_PUBLIC_BOOKING_SERVICE_URL=http://localhost:8012
NEXT_PUBLIC_LEAD_SERVICE_URL=http://localhost:8013
NEXT_PUBLIC_CONTENT_SERVICE_URL=http://localhost:8014
NEXT_PUBLIC_WIDGET_SERVICE_URL=http://localhost:8015

# Core Service URLs
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_BILLING_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:8003

# Feature Flags
NEXT_PUBLIC_ENABLE_REVIEWS=false
NEXT_PUBLIC_ENABLE_WISHLIST=false
NEXT_PUBLIC_ENABLE_COUPONS=false

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# App Configuration
NEXT_PUBLIC_APP_NAME=Beautiful Websites
NEXT_PUBLIC_APP_URL=http://localhost:3000

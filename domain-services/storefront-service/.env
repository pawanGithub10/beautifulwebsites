# Storefront Service Environment Variables

# Service Configuration
SERVICE_NAME=storefront-service
SERVICE_PORT=8011
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://platform_user:platform_pass@localhost:5432/storefront_service_db

# Redis
REDIS_URL=redis://localhost:6379/0
EVENT_BUS_URL=redis://localhost:6379/1
EVENT_BUS_BACKEND=redis

# Core Services URLs
AUTH_SERVICE_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001
BILLING_SERVICE_URL=http://localhost:8002
LLM_GATEWAY_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8004
LOGGING_SERVICE_URL=http://localhost:8005
SITE_SERVICE_URL=http://localhost:8010

# Security
SECRET_KEY=dev-secret-key-change-in-production
SERVICE_AUTH_TOKEN=dev-service-token

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8011

# Business Rules
DEFAULT_CART_EXPIRY_HOURS=24
LOW_STOCK_THRESHOLD=10
MAX_CART_ITEMS=50

# Site Service Environment Variables

# Service Configuration
SERVICE_NAME=site-service
SERVICE_PORT=8010
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://platform_user:platform_pass@localhost:5432/site_service_db

# Redis
REDIS_URL=redis://localhost:6379/0
EVENT_BUS_URL=redis://localhost:6379/1
EVENT_BUS_BACKEND=redis

# Core Services URLs
AUTH_SERVICE_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001
BILLING_SERVICE_URL=http://localhost:8002
LLM_GATEWAY_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8004
LOGGING_SERVICE_URL=http://localhost:8005

# Security
SECRET_KEY=your-secret-key-change-in-production
SERVICE_AUTH_TOKEN=service-to-service-token

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8010
